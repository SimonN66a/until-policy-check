{
  "name": "UNTIL",
  "version": "1.0.0",
  "description": "UNTIL colour, type, layout and motion tokens. Every colour is either a signed-off brand hex or derived from one with oklch().",
  "color": {
    "brand": {
      "paper": {
        "light": "#FCFCFD",
        "dark": "#FCFCFD",
        "themed": false,
        "css": "var(--paper)",
        "description": "Off-white. Page ground in light mode."
      },
      "bone": {
        "light": "#F2F4F7",
        "dark": "#F2F4F7",
        "themed": false,
        "css": "var(--bone)",
        "description": "Pale grey. Alternating band ground."
      },
      "navy": {
        "light": "#04082A",
        "dark": "#04082A",
        "themed": false,
        "css": "var(--navy)",
        "description": "UNTIL navy. Inverted bands and image captions."
      },
      "ink": {
        "light": "#01030E",
        "dark": "#01030E",
        "themed": false,
        "css": "var(--ink)",
        "description": "Near-black. Body text in light mode."
      },
      "sage": {
        "light": "#809EA0",
        "dark": "#809EA0",
        "themed": false,
        "css": "var(--sage)",
        "description": "Muted sage. Secondary brand accent, used sparingly."
      }
    },
    "surface": {
      "bg": {
        "light": "#FCFCFD",
        "dark": "#04082A",
        "themed": true,
        "css": "var(--bg)",
        "description": "Page background."
      },
      "band": {
        "light": "#F2F4F7",
        "dark": "oklch(0.215 0.052 274)",
        "themed": true,
        "css": "var(--band)",
        "description": "Alternating band and input ground."
      },
      "surface": {
        "light": "#FCFCFD",
        "dark": "oklch(0.245 0.055 274)",
        "themed": true,
        "css": "var(--surface)",
        "description": "Card and panel ground."
      }
    },
    "text": {
      "fg": {
        "light": "#01030E",
        "dark": "#FCFCFD",
        "themed": true,
        "css": "var(--fg)",
        "description": "Body text."
      },
      "muted": {
        "light": "oklch(0.49 0.024 268)",
        "dark": "oklch(0.755 0.03 272)",
        "themed": true,
        "css": "var(--muted)",
        "description": "Secondary text."
      },
      "faint": {
        "light": "oklch(0.62 0.018 268)",
        "dark": "oklch(0.66 0.032 272)",
        "themed": true,
        "css": "var(--faint)",
        "description": "Tertiary text: labels, meta, counts."
      }
    },
    "border": {
      "line": {
        "light": "oklch(0.905 0.012 268)",
        "dark": "oklch(0.335 0.05 274)",
        "themed": true,
        "css": "var(--line)",
        "description": "Hairline dividers and card borders. The 1px grid gaps are painted with this."
      },
      "line-2": {
        "light": "oklch(0.83 0.022 268)",
        "dark": "oklch(0.45 0.058 274)",
        "themed": true,
        "css": "var(--line-2)",
        "description": "Stronger border: inputs, ghost buttons, the dashed dropzone."
      }
    },
    "action": {
      "accent": {
        "light": "#111EA6",
        "dark": "#B9BEF1",
        "themed": true,
        "css": "var(--accent)",
        "description": "Primary action. Buttons, links, active chips, icons."
      },
      "accent-hi": {
        "light": "#1526D0",
        "dark": "#D0D4F6",
        "themed": true,
        "css": "var(--accent-hi)",
        "description": "Accent, raised. Hover and the focus ring."
      },
      "on-accent": {
        "light": "#FCFCFD",
        "dark": "#01030E",
        "themed": true,
        "css": "var(--on-accent)",
        "description": "Text and icons on an --accent ground."
      },
      "focus": {
        "light": "#1526D0",
        "dark": "#B9BEF1",
        "themed": true,
        "css": "var(--focus)",
        "description": "Focus ring. 2px solid, 3px offset."
      }
    },
    "verdict": {
      "ok": {
        "light": "#111EA6",
        "dark": "#B9BEF1",
        "themed": true,
        "css": "var(--ok)",
        "description": "Verdict: covered."
      },
      "ok-wash": {
        "light": "oklch(0.955 0.028 268)",
        "dark": "oklch(0.32 0.07 274)",
        "themed": true,
        "css": "var(--ok-wash)",
        "description": "Verdict: covered \u2014 tinted ground for pill and selected tile."
      },
      "lim": {
        "light": "oklch(0.44 0.035 196)",
        "dark": "#A9C2C4",
        "themed": true,
        "css": "var(--lim)",
        "description": "Verdict: limited."
      },
      "lim-wash": {
        "light": "oklch(0.955 0.016 196)",
        "dark": "oklch(0.315 0.032 200)",
        "themed": true,
        "css": "var(--lim-wash)",
        "description": "Verdict: limited \u2014 tinted ground."
      },
      "no": {
        "light": "oklch(0.48 0.155 27)",
        "dark": "oklch(0.76 0.125 27)",
        "themed": true,
        "css": "var(--no)",
        "description": "Verdict: not covered. Also inline form errors."
      },
      "no-wash": {
        "light": "oklch(0.958 0.022 27)",
        "dark": "oklch(0.33 0.07 27)",
        "themed": true,
        "css": "var(--no-wash)",
        "description": "Verdict: not covered \u2014 tinted ground."
      },
      "unk": {
        "light": "oklch(0.55 0.014 268)",
        "dark": "oklch(0.72 0.022 272)",
        "themed": true,
        "css": "var(--unk)",
        "description": "Verdict: not stated. Deliberately neutral, never alarming."
      },
      "unk-wash": {
        "light": "oklch(0.962 0.005 268)",
        "dark": "oklch(0.29 0.032 274)",
        "themed": true,
        "css": "var(--unk-wash)",
        "description": "Verdict: not stated \u2014 tinted ground."
      }
    },
    "brand-mark": {
      "logo-ink": {
        "light": "#01030E",
        "dark": "#FCFCFD",
        "themed": true,
        "css": "var(--logo-ink)",
        "description": "Wordmark fill, applied through a CSS mask so the mark flips with the theme."
      }
    },
    "elevation": {
      "shadow": {
        "light": "0 1px 2px oklch(0.25 0.04 268/.07), 0 10px 30px oklch(0.25 0.04 268/.07)",
        "dark": "0 1px 2px oklch(0 0 0/.4), 0 10px 30px oklch(0 0 0/.32)",
        "themed": true,
        "css": "var(--shadow)",
        "description": "The only elevation in the system. Panels only."
      }
    },
    "map": {
      "map-land": {
        "light": "#F2F4F7",
        "dark": "oklch(0.215 0.052 274)",
        "themed": true,
        "css": "var(--map-land)",
        "description": "Club map landmass."
      },
      "map-river": {
        "light": "#D0D4F6",
        "dark": "oklch(0.32 0.075 274)",
        "themed": true,
        "css": "var(--map-river)",
        "description": "Club map river."
      },
      "map-pin": {
        "light": "#1526D0",
        "dark": "#B9BEF1",
        "themed": true,
        "css": "var(--map-pin)",
        "description": "Club map pin and label."
      }
    }
  },
  "typography": {
    "family": {
      "display": {
        "stack": "\"Tungsten\",\"D-DIN\",sans-serif",
        "weight": 600,
        "description": "Condensed display face. Headings, tile names, tally numbers, map labels."
      },
      "text": {
        "stack": "\"D-DIN\",\"Helvetica Neue\",Helvetica,Arial,sans-serif",
        "weights": [
          400,
          700
        ],
        "description": "Body face. Everything that is not a heading."
      }
    },
    "role": {
      "h1": {
        "family": "display",
        "size": "clamp(54px,9.2vw,104px)",
        "lineHeight": 0.88
      },
      "h2": {
        "family": "display",
        "size": "clamp(34px,5vw,52px)",
        "lineHeight": 0.94
      },
      "h3": {
        "family": "display",
        "size": "26px",
        "lineHeight": 1
      },
      "hero-sub": {
        "family": "display",
        "size": "clamp(24px,3.4vw,38px)",
        "lineHeight": 1.02,
        "color": "var(--accent)"
      },
      "tally": {
        "family": "display",
        "size": "36px",
        "lineHeight": 0.86,
        "numeric": "tabular-nums"
      },
      "tile-name": {
        "family": "display",
        "size": "27px",
        "lineHeight": 0.98
      },
      "body": {
        "family": "text",
        "size": "16px",
        "lineHeight": 1.55
      },
      "lede": {
        "family": "text",
        "size": "17px",
        "lineHeight": 1.6,
        "measure": "62ch",
        "color": "var(--muted)"
      },
      "note": {
        "family": "text",
        "size": "13px",
        "lineHeight": 1.5,
        "color": "var(--faint)"
      },
      "eyebrow": {
        "family": "text",
        "size": "11px",
        "weight": 700,
        "tracking": ".16em",
        "case": "uppercase",
        "color": "var(--faint)"
      },
      "label": {
        "family": "text",
        "size": "11px",
        "weight": 700,
        "tracking": ".14em",
        "case": "uppercase",
        "color": "var(--faint)"
      },
      "button": {
        "family": "text",
        "size": "13px",
        "weight": 700,
        "tracking": ".11em",
        "case": "uppercase"
      },
      "pill": {
        "family": "text",
        "size": "10px",
        "weight": 700,
        "tracking": ".11em",
        "case": "uppercase"
      }
    }
  },
  "layout": {
    "shell": {
      "maxWidth": "1120px",
      "gutter": "24px",
      "description": "The only container. Everything sits inside it."
    },
    "band": {
      "padding": "76px 0",
      "tightPadding": "52px 0",
      "variants": [
        "default",
        "--bone",
        "--navy"
      ],
      "description": "Full-bleed horizontal section."
    },
    "grid": {
      "gap": "1px",
      "gapGround": "var(--line)",
      "description": "No rounded corners and almost no shadow. Separation is a 1px gap over --line, so grids read as a ruled sheet."
    },
    "radius": {
      "value": "0",
      "exception": "50%, on step numerals and the confirmation tick only"
    }
  },
  "motion": {
    "fast": ".14s",
    "base": ".16s",
    "panel": ".18s ease",
    "image": ".5s ease",
    "note": "Every transition is disabled under prefers-reduced-motion."
  },
  "breakpoints": {
    "note": "Max-width, mobile-last. Components declare their own; these are the recurring ones.",
    "values": [
      "1000px",
      "900px",
      "880px",
      "860px",
      "820px",
      "760px",
      "640px",
      "560px",
      "540px",
      "520px",
      "460px"
    ]
  }
}
